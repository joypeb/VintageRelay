# SQLite database URL. The data directory is created at runtime and is git-ignored.
DATABASE_URL=sqlite:///./data/app.db

# Public frontend origin used to build join links and as the only allowed CORS origin.
APP_BASE_URL=http://localhost:3000

# Minimum log level to emit.
LOG_LEVEL=INFO

# Log output format: text for development, json for deployment.
LOG_FORMAT=text

# Meta Model API key for AI clothing analysis and search.
# Required in production (the server refuses to start without it);
# export AI_API_KEY=... before running the backend or `docker compose up`.
AI_API_KEY=
